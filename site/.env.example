# The keeper's base URL (the same value as VITE_KEEPER_URL in web/'s Vercel project).
# Without it the pages still read every campaign from the contract, but the practice wallet
# gets no test USDC, one-signature pledges are off, and backer lists are empty.
NEXT_PUBLIC_KEEPER_URL=

# Set to 1 to check layouts on made-up campaigns with no network. Leave empty for the real chain.
NEXT_PUBLIC_MOCK=
