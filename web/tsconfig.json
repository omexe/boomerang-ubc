{
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "node20",
    "target": "es2023",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "verbatimModuleSyntax": true,
    "strict": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
